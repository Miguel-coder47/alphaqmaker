# Copy to .env.local. Nothing here needs a credit card to start.
AI_PROVIDER=mock            # mock (free, built in) | ollama (free, on your computer) | gemini (free tier) | anthropic (PAID)
MONTHLY_CAP_USD=0           # 0 = paid AI is OFF. Only matters if AI_PROVIDER=anthropic.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=       # server only, never in browser code

OLLAMA_MODEL=               # e.g. a model you downloaded with: ollama pull <name>
GEMINI_API_KEY=             # from Google AI Studio (free tier). Also used by tools/make-quiz.js
GEMINI_MODEL=               # pick a model marked free on Google's pricing page

ANTHROPIC_API_KEY=          # leave empty unless you choose to pay
INPUT_USD_PER_MTOK=0
OUTPUT_USD_PER_MTOK=0
